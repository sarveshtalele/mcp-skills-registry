{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "spec_markdown",
    "architecture_markdown",
    "inventory"
  ],
  "properties": {
    "spec_markdown": {
      "type": "string"
    },
    "architecture_markdown": {
      "type": "string"
    },
    "inventory": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "object"
        },
        "entry_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "module_count": {
          "type": "integer"
        }
      }
    }
  }
}
