# Copy to .env and adjust. All vars are optional; defaults work out of the box.

# Server
SKILLREG_HOST=0.0.0.0
SKILLREG_PORT=7860
SKILLREG_LOG_LEVEL=INFO

# Paths
SKILLREG_SKILLS_DIR=skills
SKILLREG_DB_PATH=data/registry.db

# Execution sandbox limits
SKILLREG_DEFAULT_TIMEOUT_SECONDS=30
SKILLREG_MAX_TIMEOUT_SECONDS=120

# Skill uploads (POST /api/v1/skills/upload)
SKILLREG_ENABLE_UPLOADS=true
SKILLREG_MAX_UPLOAD_BYTES=5000000
SKILLREG_MAX_UNCOMPRESSED_BYTES=25000000

# Optional semantic search (requires the `search` extra installed)
SKILLREG_ENABLE_SEMANTIC_SEARCH=false
SKILLREG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Agents
SKILLREG_AGENTS_DIR=agents

# UI (Next.js static export served by FastAPI)
SKILLREG_ENABLE_UI=true
SKILLREG_FRONTEND_DIR=frontend/out

# API hardening
SKILLREG_ENABLE_DOCS=false              # /docs, /redoc, /openapi.json (off by default)
SKILLREG_CORS_ALLOW_ORIGINS=*           # comma-separated origins; tighten in prod
SKILLREG_ADMIN_TOKEN=                    # set to require X-Admin-Token on upload/delete/reload
SKILLREG_MAX_INPUT_BYTES=256000         # cap on execute input payload size
# Env vars a skill subprocess may receive (server secrets are never exposed):
SKILLREG_SKILL_ENV_ALLOWLIST=JIRA_BASE_URL,JIRA_EMAIL,JIRA_API_TOKEN,SERVICENOW_INSTANCE,SERVICENOW_USER,SERVICENOW_PASSWORD
