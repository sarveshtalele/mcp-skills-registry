# Copy to .env and adjust. All vars are optional; defaults work out of the box.

# Server
SKILLREG_HOST=0.0.0.0
SKILLREG_PORT=7860
SKILLREG_LOG_LEVEL=INFO

# Paths
SKILLREG_SKILLS_DIR=skills
SKILLREG_DB_PATH=data/registry.db

# Execution sandbox limits
SKILLREG_DEFAULT_TIMEOUT_SECONDS=30
SKILLREG_MAX_TIMEOUT_SECONDS=120

# Skill uploads (POST /api/v1/skills/upload)
SKILLREG_ENABLE_UPLOADS=true
SKILLREG_MAX_UPLOAD_BYTES=5000000
SKILLREG_MAX_UNCOMPRESSED_BYTES=25000000

# Optional semantic search (requires the `search` extra installed)
SKILLREG_ENABLE_SEMANTIC_SEARCH=false
SKILLREG_EMBEDDING_MODEL=all-MiniLM-L6-v2
